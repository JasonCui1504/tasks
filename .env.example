# Signs login sessions. Any long random string: openssl rand -hex 32
TASKS_SESSION_SECRET=

# Turso/libSQL database (leave empty locally to use .data/tasks.db)
TASKS_DATABASE_URL=
TASKS_DATABASE_AUTH_TOKEN=

# Push notifications: generate with `npm run vapid`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared with the GitHub Actions schedule that calls /api/cron
CRON_SECRET=

# Read-only trip feed from travel.jascui.com: the same value as TRAVEL_FEED_SECRET there
TRAVEL_FEED_SECRET=
# TRAVEL_ORIGIN=https://travel.jascui.com

# Optional: fallback logins as JSON {"user":"salt:hash"} (see scripts/set-password.mjs --print)
# TASKS_USERS=
# DEFAULT_TIME_ZONE=America/New_York
